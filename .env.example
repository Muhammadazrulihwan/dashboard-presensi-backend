# Salin menjadi .env lalu isi nilainya. Jangan pernah commit .env.

# development atau production. "production" mengaktifkan pemeriksaan keamanan saat startup
# dan membuat seed_users.py menolak berjalan.
APP_ENV=development

# SQLite untuk lokal. Contoh MySQL: mysql+pymysql://USER:PASSWORD@localhost:3306/NAMA_DB?charset=utf8mb4
# Bila memakai docker-compose.yml di folder ini, nilainya sudah cocok:
#   DATABASE_URL=mysql+pymysql://presensi_app:admin12345@127.0.0.1:3306/presensi?charset=utf8mb4
DATABASE_URL=sqlite:///./dev.db

# Database uji terpisah untuk `pytest` di MySQL (dibuat otomatis oleh docker/mysql-init).
# Kosongkan untuk memakai SQLite sementara.
# TEST_DATABASE_URL=mysql+pymysql://presensi_app:admin12345@127.0.0.1:3306/presensi_test?charset=utf8mb4

# Alamat frontend, pisahkan dengan koma bila lebih dari satu
CORS_ORIGINS=http://localhost:3000

# String acak minimal 32 karakter. Wajib diganti di produksi.
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRE_MINUTES=480

# Wajib true di produksi (HTTPS)
COOKIE_SECURE=false

# Akun admin IT awal
ADMIN_EMAIL=admin@contoh.local
ADMIN_PASSWORD=ganti-dengan-password-kuat
ADMIN_NAME=Admin IT

# Opsional (nilai bawaan ada di app/core/config.py)
# SALES_ORG_NAMES=Sales,Marketing,Sales/Marketing
# MAX_UPLOAD_MB=50
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
